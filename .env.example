# ============================================
# Oracle - New Year Fortune Telling App
# Environment Variables Configuration
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================
# DATABASE (Required for full functionality)
# ============================================
# PostgreSQL connection string
# Get from Vercel Postgres or Supabase
# Format: postgresql://user:password@host:port/database?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/oracle?schema=public"

# ============================================
# NEXTAUTH (Required for authentication)
# ============================================
# Your application URL
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXTAUTH_URL="http://localhost:3000"

# Secret key for NextAuth (generate with: openssl rand -base64 32)
# This is used to encrypt session tokens
NEXTAUTH_SECRET="your-nextauth-secret-key-here-generate-with-openssl-rand-base64-32"

# ============================================
# GOOGLE OAUTH (Required for authentication)
# ============================================
# Get these from Google Cloud Console:
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project or select existing
# 3. Enable Google+ API
# 4. Go to Credentials → Create Credentials → OAuth 2.0 Client ID
# 5. Application type: Web application
# 6. Authorized redirect URIs:
#    - Development: http://localhost:3000/api/auth/callback/google
#    - Production: https://your-domain.com/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ============================================
# OPENAI API (Required for AI predictions)
# ============================================
# Get your API key from https://platform.openai.com/api-keys
# The app uses gpt-4o-mini model for image analysis
OPENAI_API_KEY="sk-your-openai-api-key-here"

# ============================================
# STRIPE
# ============================================
# Get these from https://dashboard.stripe.com/apikeys
# Only needed if you want to implement payment processing
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key"
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key"
STRIPE_WEBHOOK_SECRET="whsec_your-webhook-secret"





# ============================================
# NODE ENV (Automatically set by Next.js)
# ============================================
# NODE_ENV is automatically set to "development" or "production"
# You don't need to set it manually

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email"
SMTP_PASSWORD="your-smtp-email-password"
SMTP_FROM_EMAIL="your-email"
SMTP_FROM_NAME="Oracle - Tarot Reading"

AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-bucket-name
AWS_S3_BUCKET_URL=https://your-bucket.s3.amazonaws.com